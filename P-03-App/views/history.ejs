<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ประวัติการสั่งอาหาร</title>
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css" />
    <script src="js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background: linear-gradient(to bottom right, #f0f0f0, #fbe9e7);
        }
    </style>
</head>
<body>
    <%- include('header.ejs') %>
    <div class="container mt-4">
        <% 
            let overallTotal = 0;
            orders.forEach(function(order) { 
                const items = orderItems[order.order_id] || [];
                items.forEach(function(item) {
                    let basePrice = item.price || 0;
                    let itemPrice = basePrice;
                    if (item.size === 'L') itemPrice = basePrice * 1.2;
                    else if (item.size === 'S') itemPrice = basePrice * 0.8;
                    overallTotal += itemPrice * item.quantity;
                });
            });
        %>
        <h2 class="mb-4 d-flex align-items-center">
            ประวัติการสั่งอาหาร
            <span class="ms-auto text-success fs-5">รวมทั้งหมด: <strong><%= overallTotal.toLocaleString('en-US', {minimumFractionDigits: 2}) %> บาท</strong></span>
        </h2>
        <div class="accordion" id="historyAccordion">
            <% if (orders.length === 0) { %>
                <div class="text-center text-muted py-5">ไม่มีรายการ</div>
            <% } else { %>
                <% orders.forEach(function(order) { 
                    const items = orderItems[order.order_id] || [];
                    if (items.length === 0) return;
                %>
                    <div class="accordion-item mb-2">
                        <h2 class="accordion-header" id="heading<%= order.order_id %>">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= order.order_id %>" aria-expanded="false" aria-controls="collapse<%= order.order_id %>">
                                ออเดอร์ #<%= order.order_id %> | โต๊ะ: <%= typeof order.table_number !== 'undefined' ? order.table_number : order.table_id %> | เวลา: <%= order.start_time || order.created_at %>
                            </button>
                        </h2>
                        <div id="collapse<%= order.order_id %>" class="accordion-collapse collapse" aria-labelledby="heading<%= order.order_id %>" data-bs-parent="#historyAccordion">
                            <div class="accordion-body">
                                <ul class="list-group mb-3">
                                    <% if (orders.length === 0) { %>
                                        <li class="list-group-item text-center text-muted">ไม่มีรายการ</li>
                                    <% } else { %>
                                        <% items.forEach(function(item) { 
                                            let basePrice = item.price || 0;
                                            let displayPrice = basePrice * item.quantity;
                                            if (item.size === 'L') displayPrice = basePrice * 1.2;
                                            else if (item.size === 'S') displayPrice = basePrice * 0.8;
                                            // Default (M or undefined) is basePrice
                                        %>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <span>
                                                    <%= item.item_name %>
                                                    <span class="badge bg-info ms-2"><%= item.size %></span>
                                                    <span class="badge bg-secondary ms-2">x<%= item.quantity %></span>
                                                </span>
                                                <span>
                                                    <span class="text-success me-2">
                                                        <%= displayPrice ? Number(displayPrice).toLocaleString('en-US', {minimumFractionDigits: 2}) : '0.00' %> บาท
                                                    </span>
                                                    <span>สถานะ: <%= item.status_name %></span>
                                                </span>
                                            </li>
                                        <% }); %>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <%- include("cart") %>

    <%- include("footer") %>
</body>
</html>