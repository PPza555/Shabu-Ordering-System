<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serves</title>
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css" />
    <script src="js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background: linear-gradient(to bottom right, #f0f0f0, #fbe9e7);
        }
    </style>
</head>

<body>
    <%- include('staffHeader.ejs') %>

        <div class="container mt-4">
            <h2>สิ่งที่ต้องเสิร์ฟ</h2>
            <div class="accordion" id="serveAccordion">
                <% let hasServe=false; orders.forEach(function(order) { const items=orderItems[order.order_id] || []; if
                    (items.length===0) return; hasServe=true; }); %>
                    <% if (!hasServe) { %>
                        <div class="text-center text-muted py-5">ไม่มีรายการ</div>
                        <% } else { %>
                            <% orders.forEach(function(order, idx) { const items=orderItems[order.order_id] || []; if
                                (items.length===0) return; %>
                                <div class="accordion-item mb-2">
                                    <h2 class="accordion-header" id="heading<%= order.order_id %>">
                                        <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapse<%= order.order_id %>"
                                            aria-expanded="false" aria-controls="collapse<%= order.order_id %>">
                                            ออเดอร์ #<%= order.order_id %> | โต๊ะ: <%= typeof order.table_number
                                                    !=='undefined' ? order.table_number : order.table_id %> | เวลา: <%=
                                                        order.start_time || order.created_at %>
                                        </button>
                                    </h2>
                                    <div id="collapse<%= order.order_id %>" class="accordion-collapse collapse"
                                        aria-labelledby="heading<%= order.order_id %>" data-bs-parent="#serveAccordion">
                                        <div class="accordion-body">
                                            <ul class="list-group mb-3">
                                                <% items.forEach(function(item) { %>
                                                    <li class="list-group-item d-flex justify-content-between align-items-center"
                                                        data-price="<%= item.price %>">
                                                        <span>
                                                            <%= item.item_name %>
                                                                <span class="badge bg-info ms-2">
                                                                    <%= item.size %>
                                                                </span>
                                                                <span class="badge bg-secondary ms-2">x<%= item.quantity
                                                                        %></span>
                                                        </span>
                                                    </li>
                                                    <% }); %>
                                            </ul>
                                            <button class="btn btn-success serve-done-btn"
                                                data-order-id="<%= order.order_id %>">เสิร์ฟเสร็จแล้ว</button>
                                            <button class="btn btn-outline-primary ms-2 print-receipt-btn"
                                                data-table-number="<%= order.table_number || order.table_id %>"
                                                data-order-id="<%= order.order_id %>"
                                                data-order-time="<%= order.start_time || order.created_at %>">พิมพ์ใบเสร็จ</button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } %>
            </div>
        </div>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/javascripts/serve_js.js"></script>
</body>

</html>