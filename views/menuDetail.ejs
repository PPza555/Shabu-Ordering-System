<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= item.item_name %> | PP Restaurant</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            background: #f8f8f8;
            color: #333;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .detail-card {
            background: white;
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            position: relative;
            overflow: hidden;
            border: none;
        }

        /* ปุ่มกลับมุมซ้ายบน */
        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 10;
            background: white;
            border: 1px solid #eee;
            border-radius: 50px;
            padding: 8px 18px;
            font-weight: 700;
            color: #333;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            background: #dc3545;
            color: white;
            border-color: #dc3545;
            transform: translateX(-3px);
        }

        .detail-img-wrapper {
            width: 100%;
            height: 320px;
            background: #f5f5f5;
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .detail-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .quantity-control {
            display: flex;
            width: 160px;
            height: 48px;
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
        }

        .quantity-control button {
            width: 50px;
            border: none;
            background: #f5f5f5;
            font-size: 20px;
            font-weight: bold;
            color: #333;
            transition: background 0.2s;
        }

        .quantity-control button:hover {
            background: #e9e9e9;
        }

        .quantity-control input {
            flex: 1;
            border: none;
            text-align: center;
            font-weight: 700;
            font-size: 18px;
        }

        .confirm-btn {
            height: 50px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 18px;
            background: #dc3545;
            border: none;
            transition: all 0.2s ease;
        }

        .confirm-btn:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }
    </style>
</head>

<body>
    <%- include('header') %>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="detail-card p-4 p-md-5">

                    <!-- ปุ่มกดกลับที่มุมซ้ายบน -->
                    <a href="/menu" class="btn-back">
                        <i class="bi bi-arrow-left"></i> ย้อนกลับ
                    </a>

                    <div class="row g-4 align-items-center mt-3">
                        <div class="col-md-6">
                            <div class="detail-img-wrapper">
                                <img src="/menu_items/<%= item.menu_item_id %>.jpg" 
                                     class="detail-img" 
                                     alt="<%= item.item_name %>"
                                     onerror="this.src='https://via.placeholder.com/300?text=Food+Image'">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h2 class="fw-bold mb-2" style="font-size: 26px;"><%= item.item_name %></h2>
                            <p class="text-muted mb-3"><%= item.item_description || 'ไม่มีรายละเอียดเพิ่มเติมสำหรับรายการนี้' %></p>

                            <h3 class="text-danger fw-bold mb-4" style="font-size: 24px;">
                                <%= Number(item.price).toLocaleString('th-TH') %> บาท
                            </h3>

                            <!-- ตัวปรับจำนวน -->
                            <div class="mb-4">
                                <label class="form-label fw-bold d-block">จำนวน</label>
                                <div class="quantity-control">
                                    <button type="button" onclick="adjustDetailQty(-1)">−</button>
                                    <input type="number" id="detailQty" value="1" readonly>
                                    <button type="button" onclick="adjustDetailQty(1)">+</button>
                                </div>
                            </div>

                            <button type="button" class="btn btn-danger w-100 confirm-btn" onclick="addToCartFromDetail('<%= item.menu_item_id %>')">
                                <i class="bi bi-cart-plus me-2"></i> เพิ่มลงตะกร้า
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <%- include('cart.ejs') %>
    <%- include('footer') %>

    <script src="/javascripts/menu_js.js"></script>
    <script>
        function adjustDetailQty(change) {
            const input = document.getElementById('detailQty');
            let val = parseInt(input.value) + change;
            if (val < 1) val = 1;
            input.value = val;
        }

        function addToCartFromDetail(itemId) {
            const qty = parseInt(document.getElementById('detailQty').value);
            if (typeof updateCartItem === 'function') {
                updateCartItem(itemId, qty);
                alert('เพิ่มลงตะกร้าเรียบร้อยแล้ว');
            }
        }
    </script>
</body>

</html>